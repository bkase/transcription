{
  "version": "1.0.0",
  "description": "Vapor Design System Tokens - Single source of truth for colors, spacing, radii, and typography",
  "colors": {
    "primary": {
      "cloud": "#FFFFFF",
      "mist": "#F7FAFC",
      "haze": "#EDF2F7",
      "fog": "#E2E8F0",
      "overcast": "#CBD5E0"
    },
    "accent": {
      "sky": "#A0C4E8",
      "dusk": "#B8C4D8",
      "lavender": "#C9B8D8",
      "deep": "#4A90A4"
    },
    "semantic": {
      "recording": "#E88B8B",
      "success": "#90C4A8",
      "textPrimary": "#2D3748",
      "textSecondary": "#718096",
      "textTertiary": "#A0AEC0"
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 40,
    "2xl": 64
  },
  "radii": {
    "sm": 8,
    "md": 16,
    "lg": 24
  },
  "typography": {
    "fontFamily": "Inter",
    "fallbackStack": "Inter Light, -apple-system, sans-serif",
    "styles": {
      "display": {
        "fontFamily": "SF Pro Display",
        "fontWeight": 100,
        "fontSize": 34,
        "letterSpacing": -0.02
      },
      "title": {
        "fontFamily": "SF Pro Display",
        "fontWeight": 200,
        "fontSize": 28,
        "letterSpacing": -0.01
      },
      "headline": {
        "fontFamily": "SF Pro Text",
        "fontWeight": 300,
        "fontSize": 20,
        "letterSpacing": 0
      },
      "body": {
        "fontFamily": "SF Pro Text",
        "fontWeight": 300,
        "fontSize": 16,
        "letterSpacing": 0
      },
      "caption": {
        "fontFamily": "SF Pro Text",
        "fontWeight": 300,
        "fontSize": 13,
        "letterSpacing": 0.01
      },
      "timestamp": {
        "fontFamily": "SF Mono",
        "fontWeight": 300,
        "fontSize": 11,
        "letterSpacing": 0.02
      }
    },
    "lineHeight": {
      "body": 1.6,
      "headline": 1.3
    }
  },
  "motion": {
    "curves": {
      "appear": "cubic-bezier(0.16, 1, 0.3, 1)",
      "exit": "cubic-bezier(0.7, 0, 0.84, 0)",
      "drift": "cubic-bezier(0.25, 0.1, 0.25, 1)",
      "breathe": "cubic-bezier(0.45, 0, 0.55, 1)"
    },
    "durations": {
      "micro": 150,
      "normal": 300,
      "page": 400,
      "blur": 500,
      "breathe": 2000
    }
  }
}
